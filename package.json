{
  "name": "opendesk",
  "private": true,
  "version": "0.4.0",
  "description": "OpenDesk — open-source клон Word + Excel на React + TypeScript (Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
